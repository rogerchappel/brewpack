{
  "name": "brewpack",
  "version": "0.1.0",
  "description": "Local-first toolkit for scaffolding and validating small Homebrew tap repositories.",
  "type": "module",
  "main": "./src/index.js",
  "bin": {
    "brewpack": "./bin/brewpack.js"
  },
  "exports": {
    ".": "./src/index.js"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "README.md",
    "LICENSE",
    "SECURITY.md",
    "CHANGELOG.md",
    "CONTRIBUTING.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --test && npm run smoke",
    "build": "node --eval \"import('./src/index.js')\"",
    "smoke": "node scripts/smoke.mjs",
    "package:smoke": "node scripts/package-smoke.mjs",
    "release:workflow-check": "node scripts/check-release-workflows.mjs",
    "release:check": "npm run release:workflow-check && npm test && npm run build && npm run smoke && npm run package:smoke",
    "lint": "npm run check"
  },
  "keywords": [
    "homebrew",
    "tap",
    "cli",
    "packaging",
    "local-first"
  ],
  "author": "Roger Chappel",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rogerchappel/brewpack.git"
  },
  "bugs": {
    "url": "https://github.com/rogerchappel/brewpack/issues"
  },
  "homepage": "https://github.com/rogerchappel/brewpack#readme"
}
